{
  "name": "job-agent",
  "version": "1.0.0",
  "description": "Agentic job finder and resume tailor for Ayush Raj",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev:find": "ts-node src/index.ts find",
    "dev:tailor": "ts-node src/index.ts tailor",
    "dev:run": "ts-node src/index.ts run",
    "dev:schedule": "ts-node src/index.ts schedule",
    "find": "node dist/index.js find",
    "tailor": "node dist/index.js tailor",
    "start": "node dist/index.js run",
    "schedule": "node dist/index.js schedule",
    "postbuild": "echo 'Build complete. Run: npm start | npm run find | npm run tailor | npm run schedule'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
