# Required: Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Required for Job Finder: SerpApi key (https://serpapi.com/)
SERPAPI_KEY=...

# Optional: automatically tailor resumes for all found jobs without human review gate
AUTO_TAILOR=false

# Optional: include a cover note in each tailored resume output
COVER_NOTE=false

# Optional: max job listings to return per run (default: 10)
MAX_JOBS=10

# Optional: Claude model to use (default: claude-sonnet-4-6)
# Options: claude-sonnet-4-6 | claude-opus-4-7 | claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6
